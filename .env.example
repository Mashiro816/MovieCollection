# 复制本文件为 .env.local 后填写。带 VITE_ 前缀的变量会被打包进前端代码。

# TMDB（必填）：可填 v3 的 API Key，或 v4 的 Read Access Token（eyJ 开头的长串）
# .env.local 不会被提交到 git
VITE_TMDB_KEY=

# Supabase：不填则只在本机保存，不做跨设备同步
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 可选：TMDB 的代理地址（大陆网络访问不稳定时用），不填走官方地址
# VITE_TMDB_API=https://你的代理域名/3
# VITE_TMDB_IMG=https://你的代理域名/t/p
