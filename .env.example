# 复制本文件为 .env.local 后填写。.env.local 不会被提交到 git。

# TMDB（必填）：可填 v3 的 API Key，或 v4 的 Read Access Token（eyJ 开头的长串）
# 这个变量只在服务端使用，不会被打包进前端代码
TMDB_KEY=

# Supabase：不填则只在本机保存，不做跨设备同步
# 带 VITE_ 前缀的变量会被打包进前端代码，这两个值本来就是公开用的
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 可选：大陆网络访问 TMDB 不稳定时用
# TMDB_API_BASE=https://你的代理域名/3        （服务端访问 TMDB 接口的地址）
# VITE_TMDB_IMG=https://你的代理域名/t/p      （浏览器加载海报的地址）
